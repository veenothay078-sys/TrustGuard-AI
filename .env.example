# TrustGuard Environment Variables
# Copy this file to backend/.env and fill in the values

# ============================================================
# SERVER CONFIG
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# DATABASE
# ============================================================
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/trustguard

# ============================================================
# AI PROVIDER
# ============================================================
# Google Gemini API Key - get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model to use
AI_MODEL=gemini-1.5-flash

# ============================================================
# DEMO MODE
# ============================================================
# Set to "true" to run in demo mode (no Gemini API key needed)
DEMO_MODE=false

# ============================================================
# SECURITY
# ============================================================
# Secret key for internal API authentication between extension and backend
API_SECRET_KEY=trustguard_local_secret_change_in_production

# Allowed frontend origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,chrome-extension://

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# FILE UPLOAD
# ============================================================
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
